{
  "$description": "bostoncyberx design tokens. Format: Design Tokens Format Module 2025.10 (DTCG). Single source of truth for colour, typography and motion across web, decks and print. Generate CSS custom properties, Figma variables and deck theme values from this file. Do not hand-edit bcx.css values that originate here.",
  "$extensions": {
    "com.bostoncyberx.meta": {
      "version": "1.0.0",
      "brandGuideVersion": "2.1-pending",
      "owner": "scott.mccarthy@bostoncyberx.com",
      "notes": "Prose rules (voice, banned words, punctuation, product-name casing, the red budget) are NOT tokens. They live in the bostoncyberx-brand skill. Tokens carry values; the skill carries rules."
    }
  },
  "color": {
    "$type": "color",
    "$description": "Core palette. Brand Red is identity only: never a button, chart series or section wash. That rule is enforced in prose, not by this file.",
    "ink": {
      "$value": "#0A0E1A",
      "$description": "Page ground"
    },
    "paper": {
      "$value": "#F8FAFC",
      "$description": "Primary text on ink"
    },
    "deep": {
      "$value": "#111827",
      "$description": "Raised surface on ink"
    },
    "deep-2": {
      "$value": "#151D2E",
      "$description": "Second raised surface"
    },
    "slate": {
      "$value": "#94A3B8",
      "$description": "Secondary text, default icon"
    },
    "slate-2": {
      "$value": "#7A8CA6",
      "$description": "Mono labels. Introduced by the Deck OS."
    },
    "red": {
      "$value": "#FF3B30",
      "$description": "Brand Red. Identity only: the wordmark x, the monogram, one watermark, emphasised headline words, the defense beam."
    },
    "red-print": {
      "$value": "#E02D22",
      "$description": "Brand Red, print. CMYK C0 M88 Y84 K0."
    },
    "signal-blue": {
      "$value": "#3B82F6",
      "$description": "Transform pillar"
    },
    "electric-cyan": {
      "$value": "#22D3EE",
      "$description": "Defend pillar"
    },
    "guard-green": {
      "$value": "#34D399",
      "$description": "Achieve pillar"
    },
    "alert-amber": {
      "$value": "#FBBF24",
      "$description": "Risk and gap callouts only"
    },
    "line": {
      "$value": "rgba(148,163,184,.16)",
      "$description": "Default hairline / border. From bcx.css --line."
    },
    "red-hover": {
      "$value": "#C42218",
      "$description": "Primary button hover. From bcx.css .btn-primary:hover / .btn-green:hover."
    },
    "white": {
      "$value": "#fff",
      "$description": "Solid white text on filled buttons and skip-link."
    },
    "shadow-ink": {
      "$value": "rgba(2,6,17,.35)",
      "$description": "Card elevation shadow color stop. From bcx.css --shadow."
    },
    "red-glow": {
      "$value": "rgba(224,45,34,.25)",
      "$description": "Primary button box-shadow tint."
    },
    "cyan-focus-ring": {
      "$value": "rgba(34,211,238,.15)",
      "$description": "Form focus ring. From bcx.css .form input:focus box-shadow."
    }
  },
  "pillar": {
    "$type": "color",
    "$description": "Semantic aliases. Use these in pillar-scoped surfaces so a palette change propagates without find-and-replace.",
    "transform": {
      "$value": "{color.signal-blue}"
    },
    "defend": {
      "$value": "{color.electric-cyan}"
    },
    "achieve": {
      "$value": "{color.guard-green}"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "Three families, each with one job. Body copy never uses display. Mono never leaves a data position.",
      "display": {
        "$value": [
          "Archivo",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Headings, display type, the wordmark. Width axis 112."
      },
      "body": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "sans-serif"
        ],
        "$description": "All running text"
      },
      "data": {
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "Data positions only: statistics, telemetry, measurements, section numbers, code, URLs"
      },
      "body-web": {
        "$value": [
          "Archivo",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Live site body stack (matches current bcx.css --font-body). Inter remains the brand body token for decks/print; not wired to bcx.css in this PR."
      },
      "mono-web": {
        "$value": [
          "Archivo",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Live site mono alias equals display/Archivo today (--font-mono: var(--font-display)). Geist Mono not applied yet."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "body": {
        "$value": 400
      },
      "body-medium": {
        "$value": 500
      },
      "label": {
        "$value": 600
      },
      "wordmark": {
        "$value": 640,
        "$description": "Archivo variable weight for the wordmark"
      },
      "display": {
        "$value": 700
      },
      "display-max": {
        "$value": 800
      },
      "numeral": {
        "$value": 700,
        "$description": "Numerals when they carry an argument"
      }
    },
    "size": {
      "$type": "dimension",
      "body-min": {
        "$value": {
          "value": 1,
          "unit": "rem"
        },
        "$description": "16px floor for body copy"
      }
    },
    "tracking": {
      "$type": "dimension",
      "$description": "Letter-spacing. Source values are in thousandths of an em, the design-tool convention; expressed here in rem, which DTCG permits. Display minus 28 becomes -0.028rem.",
      "display": {
        "$value": {
          "value": -0.028,
          "unit": "rem"
        }
      },
      "subhead": {
        "$value": {
          "value": -0.02,
          "unit": "rem"
        }
      },
      "wordmark": {
        "$value": {
          "value": -0.012,
          "unit": "rem"
        }
      },
      "label": {
        "$value": {
          "value": 0.16,
          "unit": "rem"
        },
        "$description": "Label caps, plus 160"
      }
    },
    "line-height": {
      "$type": "number",
      "$description": "Unitless multipliers.",
      "body": {
        "$value": 1.62
      },
      "display": {
        "$value": 1.05
      }
    },
    "measure": {
      "$type": "number",
      "body": {
        "$value": 70,
        "$description": "Maximum characters per line for body copy"
      }
    }
  },
  "motion": {
    "duration": {
