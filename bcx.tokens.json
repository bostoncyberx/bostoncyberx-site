        },
        "$description": "Ceiling for state feedback"
      },
      "stagger-min": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "stagger-max": {
        "$value": {
          "value": 140,
          "unit": "ms"
        }
      },
      "logo-sequence": {
        "$value": {
          "value": 2000,
          "unit": "ms"
        },
        "$description": "Plays once per session"
      },
      "deck-build": {
        "$value": {
          "value": 400,
          "unit": "ms"
        },
        "$description": "Deck builds are fades only, 300 to 500ms"
      },
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        },
