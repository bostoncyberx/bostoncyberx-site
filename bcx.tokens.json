      "primary": {
        "$value": {
          "value": 120,
          "unit": "px"
        }
      },
      "stacked": {
        "$value": {
          "value": 64,
          "unit": "px"
        }
      },
      "mark": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      }
    }
  },
  "elevation": {
    "card": {
      "$type": "shadow",
      "$value": "0 10px 28px rgba(2,6,17,.35)",
      "$description": "From bcx.css --shadow. Kept as CSS shadow string for exact parity."
    },
    "button-primary": {
      "$type": "shadow",
      "$value": "0 12px 30px rgba(224,45,34,.25)",
      "$description": "From .btn-primary / .btn-green box-shadow."
    }
  }
