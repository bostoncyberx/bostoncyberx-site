      },
      "node": {
        "$value": {
          "value": 400,
          "unit": "ms"
        },
        "$description": "Signal node stroke/fill (.4s)."
      },
      "reveal": {
        "$value": {
          "value": 500,
          "unit": "ms"
        },
        "$description": "Territory list rise (.5s)."
      },
      "swap": {
        "$value": {
          "value": 450,
          "unit": "ms"
        },
        "$description": "Forge letter color/transform (.45s)."
      },
      "expand": {
        "$value": {
          "value": 550,
          "unit": "ms"
        },
        "$description": "Agenda body expand / intro splash (.55s)."
      },
      "view-in": {
        "$value": {
          "value": 260,
          "unit": "ms"
        },
        "$description": "View transition in (.26s)."
      },
      "color-shift": {
        "$value": {
          "value": 350,
          "unit": "ms"
        },
        "$description": "Agenda need color/size (.35s)."
      },
      "progress": {
        "$value": {
          "value": 1100,
          "unit": "ms"
        },
        "$description": "Gapviz fill (1.1s)."
      },
      "gauge": {
        "$value": {
          "value": 1400,
          "unit": "ms"
        },
        "$description": "Gauge fill (1.4s)."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "entrance": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ]
      },
      "soft": {
        "$value": [
          0.22,
          0.61,
          0.36,
          1
        ],
        "$description": "Secondary easing used by forge, scroll-hint, panel swaps in bcx.css."
      }
    },
    "distance": {
      "$type": "dimension",
      "entrance-rise": {
        "$value": {
          "value": 22,
          "unit": "px"
        }
      }
    }
  },
  "layout": {
    "grid": {
      "$description": "Deck canvas geometry, 1920 by 1080.",
      "columns": {
        "$type": "number",
        "$value": 12
      },
      "margin-pct": {
        "$type": "number",
        "$value": 6.4
      },
      "gutter-pct": {
        "$type": "number",
        "$value": 1.6
      },
      "points-max": {
        "$type": "number",
        "$value": 3,
        "$description": "Maximum points per slide"
      },
      "lines-max": {
        "$type": "number",
        "$value": 2,
        "$description": "Maximum lines per point"
      }
    },
    "web": {
      "$description": "Static site layout primitives from bcx.css :root.",
      "max-width": {
        "$type": "dimension",
        "$value": {
          "value": 1160,
          "unit": "px"
        },
        "$description": "From --maxw"
      },
